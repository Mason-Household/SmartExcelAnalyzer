# Copy this file to .env and adjust values as needed.
# docker compose will work without a .env file because defaults are set in docker-compose.yml.

# Qdrant
QDRANT_API_KEY=local-1234567890abcdef
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_USE_HTTPS=false

# Backend (.NET uses double-underscore nesting)
DatabaseOptions__HOST=qdrant
# Qdrant serves REST on 6333 and gRPC on 6334; the .NET client uses gRPC.
DatabaseOptions__PORT=6333
DatabaseOptions__GRPC_PORT=6334
DatabaseOptions__QDRANT_API_KEY=local-1234567890abcdef
DatabaseOptions__SAVE_BATCH_SIZE=100
DatabaseOptions__MAX_CONNECTION_COUNT=5
DatabaseOptions__DatabaseName=smartexcel
DatabaseOptions__CollectionName=documents
DatabaseOptions__CollectionNameTwo=summaries

# LLM service URLs (backend -> Python LLM)
LLMServiceOptions__LLM_SERVICE_URL=http://llm-service:8000
LLMServiceOptions__LLM_SERVICE_URLS__0=http://llm-service:8000

# Optional model overrides for the LLM service.
# TEXT_GENERATION_MODEL must be instruction-tuned and seq2seq (T5 family).
# flan-t5-large is the default; downgrade to flan-t5-base on a memory-constrained host.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TEXT_GENERATION_MODEL=google/flan-t5-large
